# agent service
SERVICE_NAME=agent
PORT=3000
DATABASE_URL=postgres://pmos:pmos@localhost:5432/pmos
DATABASE_SCHEMA=agent_
NATS_URL=nats://localhost:4222
LOG_LEVEL=info
OTEL_ENABLED=false
# DND window (UTC hours, "HH-HH", wraps midnight, e.g. 22-8 = 22:00–08:00). Unset = no restriction.
AGENT_DND_HOURS=
# Max agent messages per UTC day. Unset = no restriction.
AGENT_DAILY_LIMIT=
