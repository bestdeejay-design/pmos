# ai-gateway service
SERVICE_NAME=ai-gateway
PORT=3000
DATABASE_URL=postgres://pmos:pmos@localhost:5432/pmos
DATABASE_SCHEMA=ai_gateway_
NATS_URL=nats://localhost:4222
LOG_LEVEL=info
OTEL_ENABLED=false

# ── LLM providers ─────────────────────────────────────────────
# Fallback chain: configured cloud (only if its key is present) → Ollama → heuristic.
# With NO cloud keys set, behavior is identical to before (Ollama default).

# Local Ollama (default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000

# Optional cloud providers — set a key to enable that provider.
# LLM_PROVIDER forces a specific one (openai|anthropic|google); otherwise the
# first provider with a key is auto-selected.
#LLM_PROVIDER=openai
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-3-5-haiku-latest
#ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
#GOOGLE_API_KEY=
#GOOGLE_MODEL=gemini-1.5-flash
#GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Shared cloud timeout (ms) for cloud providers.
LLM_TIMEOUT_MS=30000

# ── Speech-to-text (audio dictation) ───────────────────────────
# /transcribe uses OpenAI Whisper (/v1/audio/transcriptions). Requires OPENAI_API_KEY.
#OPENAI_STT_MODEL=whisper-1
