{
  "name": "@pmos/ops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:contract": "vitest run test/contract.test.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^4.0.0",
    "@sinclair/typebox": "^0.34.0",
    "@pmos/shared": "workspace:*",
    "@pmos/event-bus": "workspace:*",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "nats": "^2.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
